   :body "use bevy_ecs::prelude::*;\nuse bevy_ecs::system::{ReadOnlySystemParam, SystemParam, SystemState};\n\n#[derive(Component)]\nstruct Foo;\n\n#[derive(SystemParam)]\nstruct Mutable<'w, 's> {\n    a: Query<'w, 's, &'static mut Foo>,\n}\n\nfn main() {\n\n    let mut world = World::default();\n    let state = SystemState::<Mutable>::new(&mut world);\n    state.get(&world);\n    //~^ E0277\n}\n\nfn assert_readonly<P>()\nwhere\n    P: ReadOnlySystemParam,\n{\n}\n"} {:path "compile_fail/tests/ui/entity_ref_mut_lifetime_safety.rs"
